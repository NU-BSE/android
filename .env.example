# Optional: authenticates Hugging Face downloads and increases Hub rate limits.
HF_TOKEN=

# Required only for the Qwen chat-data generation service.
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1

# Strongly recommended: pin Uni-GUI-OpenMobile to an immutable dataset commit.
UNIGUI_REVISION=
UNIGUI_APP=settings

# Used by the train-gui-smoke Compose service.
SMOKE_RECORDS=8

# Compact GUI-Owl student pipeline. Choices: 0.5b, 1b, 1.5b.
STUDENT_SIZE=1b

# Leave empty to use the trained 2B base + gui_policy/chat adapters.
# For the recommended 0.5B cascade, point this at gui-owl-1b-distilled and set
# DISTILL_TEACHER_UNIFIED=1.
DISTILL_TEACHER_MODEL=
DISTILL_TEACHER_UNIFIED=0

# Optional bounded smoke run; empty means the full corpora.
DISTILL_MAX_RECORDS=
