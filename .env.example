# Optional: authenticates Hugging Face downloads and increases Hub rate limits.
HF_TOKEN=

# Required only for the Qwen chat-data generation service.
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1

# Strongly recommended: pin Uni-GUI-OpenMobile to an immutable dataset commit.
UNIGUI_REVISION=
UNIGUI_APP=settings

# Used by the train-gui-smoke Compose service.
SMOKE_RECORDS=8

# Calibrated progressive GUI-Owl compression. Start with 1.5b, then 1b, then 0.5b.
STUDENT_SIZE=1.5b

# Number of specialized examples per corpus used for activation calibration.
CALIBRATION_RECORDS=64

# Optional bounded debug run. Empty means use the full configured corpora/update budget.
DISTILL_MAX_RECORDS=
DISTILL_MAX_UPDATES=

# Recovery updates after non-final progressive depth cuts (28->24->20, etc.).
DISTILL_INTERMEDIATE_UPDATES=750

# Set to 1 to reuse already accepted intermediate checkpoints.
DISTILL_RESUME=0

# Required broad recovery data is configured at:
# artifacts/training/gui-owl-recovery.jsonl
# The progressive runner refuses to start recovery if that corpus is missing.
