{
  "schema_version": 1,
  "student": {
    "vlm": "project-selected-local-vlm",
    "llm": "project-selected-local-chat-llm",
    "training_mode": "lora_or_full_finetune",
    "checkpoint_format": "safetensors_or_framework_state_dict"
  },
  "teacher": {
    "profile": "flux3_early_access",
    "teacher_id": "flux3-early-access-evaluator",
    "endpoint": null,
    "model": null,
    "api_key_env": "BFL_API_KEY",
    "allowed_hosts": [
      "api.bfl.ai"
    ],
    "early_access_acknowledged": false,
    "note": "FLUX.3 has no assumed public evaluator endpoint. Configure only after receiving and reviewing an Early Access contract."
  },
  "on_policy": {
    "rollout_batch_size": 16,
    "max_steps_per_task": 12,
    "updates_per_batch": 1,
    "gamma": 0.98,
    "advantage_clip": 2.0,
    "supervised_weight": 1.0,
    "policy_weight": 0.35,
    "grounding_weight": 0.8,
    "language_weight": 0.6,
    "kl_weight": 0.04,
    "max_policy_lag": 0,
    "seed": 0
  }
}
