{
  "server": {
    "base_url": "http://127.0.0.1:11434",
    "timeout_seconds": 300,
    "max_image_bytes": 20971520,
    "allowed_image_roots": [
      "data",
      "artifacts",
      "tests/fixtures"
    ]
  },
  "qwen3_vl": {
    "model": "android-qwen3-vl-teacher:latest",
    "role": "multimodal_teacher",
    "required_capabilities": ["completion", "vision"],
    "keep_alive": "30m",
    "num_ctx": 32768,
    "temperature": 0.0,
    "top_p": 1.0
  },
  "ui_tars": {
    "model": "android-ui-tars-critic:latest",
    "role": "gui_critic",
    "required_capabilities": ["completion", "vision"],
    "keep_alive": "30m",
    "num_ctx": 16384,
    "temperature": 0.0,
    "top_p": 1.0,
    "coordinate_scale": 1000
  },
  "ensemble": {
    "ui_tars_weight": 0.25,
    "min_critic_agreement": 0.35
  }
}
