{
  "schema_version": 2,
  "base_model": "mPLUG/GUI-Owl-1.5-2B-Instruct",
  "adapters": {
    "gui_policy": {
      "dataset_id": "UI-MOPD/Uni-GUI-OpenMobile",
      "app": "settings",
      "prepared_jsonl": "artifacts/training/gui-policy-unigui-openmobile.jsonl",
      "format": "gui_owl_tool_sft",
      "stage_1_objective": "completion_sft",
      "lora": {
        "rank": 16,
        "alpha": 32,
        "dropout": 0.0,
        "target_modules": [
          "q_proj",
          "k_proj",
          "v_proj",
          "o_proj",
          "gate_proj",
          "up_proj",
          "down_proj"
        ]
      }
    },
    "chat": {
      "generator_model": "qwen3.7-plus",
      "api_key_env": "DASHSCOPE_API_KEY",
      "base_url_env": "DASHSCOPE_BASE_URL",
      "prepared_jsonl": "artifacts/training/chat-screen-qa-qwen.jsonl",
      "format": "chat_completion_sft",
      "lora": {
        "rank": 16,
        "alpha": 32,
        "dropout": 0.05,
        "target_modules": [
          "q_proj",
          "k_proj",
          "v_proj",
          "o_proj",
          "gate_proj",
          "up_proj",
          "down_proj"
        ]
      }
    }
  },
  "ui_mopd_stage_2": {
    "platform_teacher_routing": {
      "mobile": "gui_policy"
    },
    "rollouts_per_prompt": 8,
    "policy_ratio_clip": {
      "low": 0.2,
      "high": 0.28
    },
    "reverse_kl": {
      "estimator": "k3",
      "coefficient": 0.01,
      "delta_clip": 20.0,
      "adaptive_group_reward_threshold": 0.8
    },
    "structured_action_reward": {
      "exact": 1.0,
      "partial": -0.5,
      "invalid": -1.0
    }
  }
}
